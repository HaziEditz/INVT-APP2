{
  "expo": {
    "name": "BookaWaka Driver",
    "slug": "taxi360-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookawakadriver",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bookawaka.driver",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyAg5Q5LyM2Bv0xpeHz4gPRG1MwMh71klis"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BookaWaka Driver needs your location for dispatch and navigation.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BookaWaka Driver tracks location in the background while you are online or on a job.",
        "NSLocationAlwaysUsageDescription": "BookaWaka Driver tracks location in the background while you are online or on a job.",
        "NSCameraUsageDescription": "BookaWaka Driver uses the camera to scan Total Mobility and payment cards.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"],
        "LSApplicationQueriesSchemes": ["tel", "sms"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.bookawaka.driver",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAg5Q5LyM2Bv0xpeHz4gPRG1MwMh71klis"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CAMERA",
        "android.permission.NFC"
      ]
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BookaWaka Driver needs background location for dispatch.",
          "locationWhenInUsePermission": "BookaWaka Driver needs your location for dispatch.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1a73e8",
          "sounds": ["./assets/sounds/alert.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BookaWaka Driver to scan Total Mobility and payment cards.",
          "recordAudioAndroid": false
        }
      ],
      "expo-ocr-kit",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false,
          "locationWhenInUsePermission": "Location is required to accept card payments.",
          "tapToPayCheck": true,
          "appDelegate": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withUseRawPropsJsiValue.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8cf080aa-8fbc-4bce-b653-6c865d1db592",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8cf080aa-8fbc-4bce-b653-6c865d1db592"
      },
      "dispatchApiUrl": "https://invt-production.up.railway.app",
      "paymentsApiUrl": "https://invt-superadmin-production.up.railway.app"
    },
    "owner": "lovesaf"
  }
}
